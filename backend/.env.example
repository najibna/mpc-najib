# OpenRouter powers Ask AI
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://localhost:3000
PORT=8010

# MongoDB & RabbitMQ (docker-compose sets these)
MONGODB_URI=mongodb://localhost:27017/intact
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MESSAGING_ENABLED=true
