# OpenRouter powers Ask AI. Copy to .env or set as environment variables.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Comma-separated CORS origins for the frontend dev server.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://localhost:5181

# Server port (default 8010)
PORT=8010
